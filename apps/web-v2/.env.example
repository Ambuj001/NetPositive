# Optional. Free project ID from https://cloud.reown.com — enables the WalletConnect QR option.
VITE_WALLETCONNECT_PROJECT_ID=

# AI chatbot API (chatbot/server.py on the ai-chatbot branch). Defaults to http://127.0.0.1:8787
VITE_CHATBOT_URL=

# Account/World ID/disputes API. Same contract as the testing branch backend.
# Empty uses /api with the local Vite proxy to http://127.0.0.1:8080.
# Use an HTTPS API URL when hosting the frontend separately.
VITE_API_URL=
# Optional local proxy target, read by Vite (not exposed to browser code).
# API_PROXY_TARGET=http://127.0.0.1:8080
