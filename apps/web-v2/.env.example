# Optional. Free project ID from https://cloud.reown.com — enables the WalletConnect QR option.
VITE_WALLETCONNECT_PROJECT_ID=

# Leave empty in dev. Vite proxies /api to http://localhost:8080.
# Set a full origin (https://api.example.com) for a deployed backend.
VITE_API_URL=

# Public values from the World Developer Portal. The RP signing key stays on the server.
VITE_WORLD_ID_APP_ID=app_ee3eaaf80b272b3dff6854c30744dd65
VITE_WORLD_ID_RP_ID=
VITE_WORLD_ID_ACTION=netpositive-account
# staging opens the IDKit simulator. Use production for real World App proofs.
# LOCAL DEVELOPMENT ONLY: skip the World ID widget and register the wallet directly. The backend must also run
# WORLD_ID_DEV_BYPASS=true. Ignored by production builds.
VITE_WORLD_ID_BYPASS=false
VITE_WORLD_ID_ENV=staging

# AI chatbot API (chatbot/server.py on the ai-chatbot branch). Defaults to http://127.0.0.1:8787
VITE_CHATBOT_URL=
