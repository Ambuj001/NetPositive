# Optional. Free project ID from https://cloud.reown.com. Enables WalletConnect (QR on desktop, wallet apps on phones)
# for the configured Arc network. Add this site's origin to the project's allowed domains there.
# Without it the WalletConnect rows are hidden (a hint shows under `npm run dev` only); phones still get
# "Open in wallet app" links for MetaMask, OKX, Trust and Coinbase.
VITE_WALLETCONNECT_PROJECT_ID=

# Leave empty in dev. Vite proxies /api to http://localhost:8080.
# Set a full origin (https://api.example.com) for a deployed backend.
VITE_API_URL=

# World ID: the app reads app id, action, environment and the dev-bypass flag from the backend (GET /world-id/config),
# so it always matches what the server checks. These are only fallbacks for when the backend can't be reached.
VITE_WORLD_ID_APP_ID=app_ee3eaaf80b272b3dff6854c30744dd65
VITE_WORLD_ID_RP_ID=
VITE_WORLD_ID_ACTION=netpositive-account
# staging opens the IDKit simulator. Use production for real World App proofs.
# LOCAL DEVELOPMENT ONLY: skip the World ID widget and register the wallet directly. The backend must also run
# WORLD_ID_DEV_BYPASS=true. Ignored by production builds.
VITE_WORLD_ID_BYPASS=false
VITE_WORLD_ID_ENV=staging

# Network and contract. `npm run build` reads .env.production (committed, no secrets), which targets Arc mainnet and
# the live VoucherEscrowV2 at 0x14ed5880d4c2cbf0459f5ab019651aaa0f168ea2. `npm run dev` ignores that file and uses
# the values below (or .env / .env.local). To build for testnet, set both variables in .env.production.local or in
# the host's environment; real environment variables win over the files.
#
# Which Arc network this build talks to: testnet (default) or mainnet.
#   testnet  chain 5042002, https://rpc.testnet.arc.io, test USDC from the faucet
#   mainnet  chain 5042 (0x13b2), https://rpc.mainnet.arc.io, real USDC
# The app refuses to continue if the wallet or the backend (/health chainId) is on a different chain.
VITE_ARC_NETWORK=testnet
# Optional: another RPC URL for the browser's own read of the escrow ("check it yourself" box). Defaults to the public node.
VITE_ARC_RPC_URL=
# Address of the VoucherEscrowV2 contract this build trusts. REQUIRED for a production build: without it the app
# refuses to lock, release or verify anything ("escrow is not configured"). If the backend names a different
# contract, the app stops. In `npm run dev` it may be left empty; the backend's address is used then.
VITE_ESCROW_CONTRACT=

# AI chatbot API (chatbot/server.py on the ai-chatbot branch). The app sends the backend sign-in token to it
# (Authorization: Bearer <JWT>). Under `npm run dev` it defaults to http://127.0.0.1:8787. A production build has
# no default: leave it empty and the assistant is switched off with a short note.
VITE_CHATBOT_URL=
