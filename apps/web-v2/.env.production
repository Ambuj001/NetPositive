# Defaults for `npm run build` (Vite loads this file in production mode only; `npm run dev` never reads it).
# Committed on purpose: these are public facts, not secrets. Do not put keys or tokens here.
# Override per deployment with real environment variables or .env.production.local.

# Arc mainnet: chain 5042, https://rpc.mainnet.arc.io, real USDC.
VITE_ARC_NETWORK=mainnet
# The live VoucherEscrowV2 contract on Arc mainnet. The app refuses to continue if the backend names another one.
VITE_ESCROW_CONTRACT=0x14ed5880d4c2cbf0459f5ab019651aaa0f168ea2
