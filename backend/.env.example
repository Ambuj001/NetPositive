# ---------- Server ----------
PORT=8080
NODE_ENV=development
# Comma-separated list of allowed browser origins (frontend / extension).
CORS_ORIGINS=http://localhost:3000

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me
JWT_TTL=12h

# 32-byte key (64 hex chars) used to encrypt voucher codes at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOUCHER_ENC_KEY=replace-me

# How voucher codes may be submitted: sealed (client-side encrypted only, server never sees a code), legacy (plaintext, encrypted at
# rest with VOUCHER_ENC_KEY) or both (migration). Use `sealed` once the frontend uses backend/vault-sdk. See docs/vault.md.
VOUCHER_MODE=both
# Optional dispute key: X25519 PUBLIC key (64 hex). Sealed vouchers must also be sealed to it so a dispute can be judged.
# Keep the private half offline. Leave empty to disable.
ADMIN_VAULT_PUBLIC_KEY=

# Wallet addresses (comma-separated) allowed to resolve disputes.
ADMIN_ADDRESSES=

# Shared secret for POST /internal/sweep (external cron). Leave empty to disable the endpoint.
CRON_SECRET=
# In-process sweeper interval in seconds (0 = off).
SWEEP_INTERVAL_SECONDS=60

# ---------- Request lifecycle ----------
# Minutes a fulfiller has to submit a code after accepting.
FULFIL_WINDOW_MINUTES=30
# Minutes the requester has to confirm or dispute a submitted code before auto-release.
REVIEW_WINDOW_MINUTES=60

# ---------- Firebase ----------
FIREBASE_PROJECT_ID=demo-netpositive
# One of:
#  (a) path to a service-account JSON via GOOGLE_APPLICATION_CREDENTIALS
#  (b) the JSON itself inline (single line)
#  (c) FIRESTORE_EMULATOR_HOST for local dev (no credentials needed)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# ---------- World ID ----------
WORLD_ID_APP_ID=app_ee3eaaf80b272b3dff6854c30744dd65
# From the Developer Portal after enabling World ID 4.0. The signing key is secret and shown once.
WORLD_ID_RP_ID=
WORLD_ID_SIGNING_KEY=
WORLD_ID_ACTION=netpositive-account
# Must match the frontend. staging uses the IDKit simulator. production is required when NODE_ENV=production.
WORLD_ID_ENV=staging
# POST {this}/{rp_id} with the IDKit result.
WORLD_ID_VERIFY_URL=https://developer.world.org/api/v4/verify
# Set to true ONLY for local testing without a World App. Refused when NODE_ENV=production.
WORLD_ID_MOCK=false
# LOCAL ONLY: skip World ID so any wallet can register (each wallet becomes its own fake person). The server refuses to start
# with this on in production, or whenever WORLD_ID_ENV=production. Leave false for demos of the real check.
WORLD_ID_DEV_BYPASS=false

# ---------- Arc / Escrow ----------
# "chain" = real contract calls. "mock" = skip chain (local dev only, refused in production).
ESCROW_MODE=mock
# Arc testnet (default): https://rpc.testnet.arc.io, chain 5042002. Arc mainnet: https://rpc.mainnet.arc.io, chain 5042.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
# VoucherEscrowV2 (contracts/src/VoucherEscrowV2.sol).
ESCROW_CONTRACT_ADDRESS=
# USDC's ERC-20 address, the same on Arc mainnet and testnet.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Keeper: a key with NO role in the contract. It only pays gas for calls anyone may send (claim after the review
# window, refund after expiry). Fund it with a little USDC for gas. 64 hex chars. Never commit.
ESCROW_KEEPER_PRIVATE_KEY=
# Arbiter (optional): can only split escrows the spender has put in dispute. Must differ from the keeper. Leave empty
# to have the arbiter rule from their own wallet or multisig. Never commit.
ESCROW_ARBITER_PRIVATE_KEY=
# How long a funded order stays open for a buyer, in seconds (1 hour to 30 days).
ESCROW_ORDER_TTL_SECONDS=259200
# USDC uses 6 decimals.
USDC_DECIMALS=6

# Dispute stake for the local mock only. On-chain the stake is the escrow contract's disputeBond; keep this 0 when ESCROW_MODE=chain.
DISPUTE_BOND_USDC=0
DISPUTE_MAX_EVIDENCE_PER_PARTY=4
DISPUTE_MAX_IMAGE_BYTES=500000

# ---------- Live rates (/rates) ----------
# Restrict sources (comma list); empty = all: coinbase,frankfurter,erapi,pyth,wazirx,coindcx,binance,bybit,kucoin
RATES_SOURCES=
RATES_REFRESH_SECONDS=60
RATES_P2P_TTL_SECONDS=30
RATES_MAX_STALE_SECONDS=900
RATES_OUTLIER_PCT=3
RATES_DEFAULT_AMOUNT_INR=10000
P2P_MIN_COMPLETION=0.9
P2P_MIN_ORDERS=20
# Signs /rates/attestation (default: first attestor key). Never commit a real key.
RATES_SIGNER_PRIVATE_KEY=
# Optional: Pyth Hermes key for the FX.USD/INR oracle feed
PYTH_API_KEY=

# ---------- Production hardening (defaults shown are what production uses when unset) ----------
# Number of proxies in front of the server (load balancer / platform router), so client addresses are read correctly.
TRUST_PROXY=0
# Requests per minute per client address: all requests, and writes/sign-ins. 0 = off. Off by default outside production.
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITES_PER_MINUTE=60
# One JSON log line per request (no bodies or tokens).
REQUEST_LOG=true
# A new order's INR/USDC pair must be within this % of the live USD/INR rate. 0 = off. Off by default outside production.
RATE_MAX_DEVIATION_PCT=15
