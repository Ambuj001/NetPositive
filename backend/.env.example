# ---------- Server ----------
PORT=8080
NODE_ENV=development
# Comma-separated list of allowed browser origins (frontend / extension).
CORS_ORIGINS=http://localhost:3000

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me
JWT_TTL=12h

# 32-byte key (64 hex chars) used to encrypt voucher codes at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOUCHER_ENC_KEY=replace-me

# How voucher codes may be submitted: sealed (client-side encrypted only, server never sees a code), legacy (plaintext, encrypted at
# rest with VOUCHER_ENC_KEY) or both (migration). Use `sealed` once the frontend uses backend/vault-sdk. See docs/vault.md.
VOUCHER_MODE=both
# Optional dispute key: X25519 PUBLIC key (64 hex). Sealed vouchers must also be sealed to it so a dispute can be judged.
# Keep the private half offline. Leave empty to disable.
ADMIN_VAULT_PUBLIC_KEY=

# Wallet addresses (comma-separated) allowed to resolve disputes.
ADMIN_ADDRESSES=

# Shared secret for POST /internal/sweep (external cron). Leave empty to disable the endpoint.
CRON_SECRET=
# In-process sweeper interval in seconds (0 = off).
SWEEP_INTERVAL_SECONDS=60

# ---------- Request lifecycle ----------
# Minutes a fulfiller has to submit a code after accepting.
FULFIL_WINDOW_MINUTES=30
# Minutes the requester has to confirm or dispute a submitted code before auto-release.
REVIEW_WINDOW_MINUTES=60

# ---------- Firebase ----------
FIREBASE_PROJECT_ID=demo-netpositive
# One of:
#  (a) path to a service-account JSON via GOOGLE_APPLICATION_CREDENTIALS
#  (b) the JSON itself inline (single line)
#  (c) FIRESTORE_EMULATOR_HOST for local dev (no credentials needed)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

# ---------- World ID ----------
WORLD_ID_APP_ID=app_ee3eaaf80b272b3dff6854c30744dd65
# From the Developer Portal after enabling World ID 4.0. The signing key is secret and shown once.
WORLD_ID_RP_ID=
WORLD_ID_SIGNING_KEY=
WORLD_ID_ACTION=netpositive-account
# Must match the frontend. staging uses the IDKit simulator. production is required when NODE_ENV=production.
WORLD_ID_ENV=staging
# POST {this}/{rp_id} with the IDKit result.
WORLD_ID_VERIFY_URL=https://developer.world.org/api/v4/verify
# Set to true ONLY for local testing without a World App. Refused when NODE_ENV=production.
WORLD_ID_MOCK=false
# LOCAL ONLY: skip World ID so any wallet can register (each wallet becomes its own fake person). The server refuses to start
# with this on in production, or whenever WORLD_ID_ENV=production. Leave false for demos of the real check.
WORLD_ID_DEV_BYPASS=false

# ---------- Arc / Escrow ----------
# "chain" = real contract calls. "mock" = skip chain (local dev only, refused in production).
ESCROW_MODE=mock
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ESCROW_CONTRACT_ADDRESS=
# Private key of the operator role on the escrow contract (release/refund).
# 64 hex chars; a leading 0x is optional. Never commit.
ESCROW_OPERATOR_PRIVATE_KEY=
# USDC uses 6 decimals.
USDC_DECIMALS=6
