# Settings for the Firebase deployment. Copy this file to  .env.<your-firebase-project-id>  (for example .env.netpositive-prod).
# Nothing in this file is secret. The four secrets live in Secret Manager: run `npm run firebase:secrets`.
# Do not add FIREBASE_PROJECT_ID or PORT here: Firebase provides them.

NODE_ENV=production
# The web app's address(es), comma-separated, https only.
CORS_ORIGINS=https://net-positive-two.vercel.app
# Administrator wallets: the admin screen and dispute decisions (comma-separated, lowercase).
ADMIN_ADDRESSES=
VOUCHER_MODE=sealed

# World ID (from the World developer portal). The signing key is a secret, not set here.
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
WORLD_ID_ACTION=netpositive-account
WORLD_ID_ENV=production
# Whether trading needs a World ID until an administrator changes it on the admin screen.
WORLD_ID_REQUIRED=false
# Set to true (and redeploy) once the WORLD_ID_SIGNING_KEY secret exists, before switching World ID on.
USE_WORLD_ID_SECRET=false

# Escrow: VoucherEscrowV2 on Arc mainnet.
ESCROW_MODE=chain
ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
ESCROW_CONTRACT_ADDRESS=0x14ed5880d4c2cbf0459f5ab019651aaa0f168ea2
USDC_ADDRESS=0x3600000000000000000000000000000000000000
ESCROW_ORDER_TTL_SECONDS=259200
DISPUTE_BOND_USDC=0
