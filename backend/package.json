{
  "name": "netpositive-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + Firestore backend for P2P gift-card <-> USDC escrow on Arc, gated by World ID.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "emulator": "firebase emulators:start --only firestore --project demo-netpositive",
    "smoke": "firebase emulators:exec --only firestore --project demo-netpositive \"node scripts/smoke.js\"",
    "smoke:mem": "node --import ./test-support/register.mjs scripts/smoke.js",
    "vault:test": "node --test vault-sdk/test/sdk.test.mjs",
    "vault:e2e": "node --import ./test-support/register.mjs scripts/vault-e2e.mjs both && node --import ./test-support/register.mjs scripts/vault-e2e.mjs sealed",
    "sim": "node --import ./test-support/register.mjs scripts/integration-sim.js",
    "chain:e2e": "node --import ./test-support/register.mjs scripts/chain-e2e.mjs",
    "full:e2e": "node scripts/full-e2e.mjs",
    "dispute:test": "node --import ./test-support/register.mjs scripts/dispute-test.mjs && node --import ./test-support/register.mjs scripts/dispute-test.mjs nobond"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@worldcoin/idkit-core": "^4.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "jsonwebtoken": "^9.0.2",
    "viem": "^2.31.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "firebase-tools": "^14.6.0"
  }
}
