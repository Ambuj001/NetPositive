# VoucherEscrowV2 deployment (script/DeployEscrowV2.s.sol). Addresses only: no private key goes in this file.
# Sign with a Foundry keystore account or a hardware wallet:  forge script ... --account <name> --broadcast

# Multisig that owns the contract. Must be a contract on mainnet.
OWNER_ADDR="0x"
# Rules on disputed escrows only. Must differ from the owner.
ARBITER_ADDR="0x"
# Can pause new deposits only. Must differ from the owner.
GUARDIAN_ADDR="0x"
# Fee recipients: platform revenue and the dispute reserve.
TREASURY_ADDR="0x"
RESERVE_ADDR="0x"

# Optional. Defaults shown.
FEE_BPS=100                 # 1%, charged on top of the amount (hard limit 500)
RESERVE_SHARE_BPS=5000      # half of the fee goes to the dispute reserve
REVIEW_WINDOW_SECS=86400    # depositor's time to confirm or dispute after delivery
FULFILL_WINDOW_SECS=7200    # fulfiller's time to deliver after accepting
USDC_MIN=1000000            # 1 USDC per order
USDC_MAX=250000000          # 250 USDC per order
USDC_CAP=5000000000         # 5,000 USDC locked in total
USDC_DISPUTE_BOND=1000000    # 1 USDC stake to open a dispute (0 = none)
