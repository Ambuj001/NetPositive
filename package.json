{
  "name": "netpositive",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web-v2 run dev",
    "build": "npm --prefix apps/web-v2 run build",
    "preview": "npm --prefix apps/web-v2 run preview",
    "typecheck": "npm --prefix apps/web-v2 run typecheck",
    "test": "npm --prefix apps/web-v2 run test",
    "format": "prettier --write apps/web/src apps/web/vite.config.ts",
    "setup:frontend": "npm ci --prefix apps/web-v2",
    "chatbot": "npm --prefix apps/web-v2 run chatbot"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
