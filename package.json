{
  "name": "netpositive",
  "private": true,
  "version": "0.1.0",
  "description": "Root scripts delegate to apps/web-v2. The backend (backend/) and contracts (contracts/) have their own tooling.",
  "scripts": {
    "dev": "npm --prefix apps/web-v2 run dev",
    "build": "npm --prefix apps/web-v2 run build",
    "preview": "npm --prefix apps/web-v2 run preview",
    "typecheck": "npm --prefix apps/web-v2 run typecheck",
    "test": "npm --prefix apps/web-v2 test",
    "format": "prettier --write apps/web-v2/src"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
