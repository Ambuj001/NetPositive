{
  "name": "netpositive",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/vault-api",
    "packages/vault"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @netpositive/web",
    "build": "npm run build --workspace @netpositive/web",
    "preview": "npm run preview --workspace @netpositive/web",
    "typecheck": "npm run typecheck --workspace @netpositive/web",
    "test": "npm run test --workspace @netpositive/web",
    "format": "prettier --write apps/web/src apps/web/vite.config.ts",
    "dev:vault": "npm run dev --workspace @netpositive/api",
    "test:vault": "node --experimental-strip-types --test packages/vault/test/*.test.ts apps/vault-api/test/*.test.ts",
    "zk:build": "node scripts/build-zk.mjs",
    "test:contracts": "node --test contracts/test/*.test.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "deploy:arc": "node scripts/deploy-arc.mjs",
    "typecheck:vault": "tsc --project tsconfig.vault.json",
    "demo:vault": "node --experimental-strip-types scripts/demo-vault.mjs",
    "test:protocol": "forge test --summary"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "circomlib": "2.0.5",
    "hardhat": "3.21.2",
    "prettier": "^3.9.10",
    "snarkjs": "0.7.6",
    "solc": "0.8.38"
  },
  "type": "module",
  "overrides": {
    "tmp": "0.2.7",
    "underscore": "1.13.8"
  }
}
