  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "types": ["node"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "skipLibCheck": true
